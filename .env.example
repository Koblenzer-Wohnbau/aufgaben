# =====================================================================
# Aufgaben – Konfiguration für Docker Compose
#
# Kopieren nach .env und ausfüllen:   cp .env.example .env && chmod 600 .env
# Die Datei .env niemals in Git einchecken (steht in .gitignore).
# Doppelte Unterstriche (__) trennen Abschnitte: Aufgaben__Mail__Host = Aufgaben:Mail:Host
# =====================================================================

# ---------------------------------------------------------------- Compose
# Fertiges Image aus den GitHub-Releases (selbst bauen: siehe compose.build.yaml)
APP_IMAGE=ghcr.io/koblenzer-wohnbau/aufgaben
# Version (Tag), z. B. 1.0.0 – für Updates und zum Zurückrollen hier ändern.
# Bewusst keine "latest": So ändert sich nichts, ohne dass jemand die Zahl anpasst.
APP_VERSION=1.0.3
# Port auf 127.0.0.1, an den Nginx weiterleitet
APP_PORT=8090
# Datenbank-Passwort: lang und zufällig, z. B.  openssl rand -base64 36
DB_PASSWORD=

# ---------------------------------------------------------------- Grundbetrieb
# Öffentliche Adresse genau so, wie sie im Browser steht (ohne / am Ende)
Aufgaben__BaseUrl=https://aufgaben.example.de
Aufgaben__TimeZone=Europe/Berlin

# ---------------------------------------------------------------- Entra-App
AzureAd__TenantId=
AzureAd__ClientId=
# App-Zertifikat als PFX unter ./secrets/app.pfx ablegen (siehe Handbuch)
AzureAd__ClientCredentials__0__SourceType=Path
AzureAd__ClientCredentials__0__CertificateDiskPath=/certs/app.pfx
AzureAd__ClientCredentials__0__CertificatePassword=
# Übergangsweise statt Zertifikat ein geheimer Clientschlüssel: die beiden Zeilen unten aktivieren und
# SourceType=Path oben auskommentieren. In Entra den WERT kopieren (wird nur einmal angezeigt), nicht die
# „Geheime ID“ – sonst lehnt Entra die Anmeldung mit AADSTS7000215 ab. Ablaufdatum in den Kalender.
# AzureAd__ClientCredentials__0__SourceType=ClientSecret
# AzureAd__ClientCredentials__0__ClientSecret=

# Application ID URI für Teams-SSO: api://<domain>/<client-id>
Aufgaben__Auth__ApiAudience=api://aufgaben.example.de/00000000-0000-0000-0000-000000000000
Aufgaben__Auth__AdminRole=Aufgaben.Admin
Aufgaben__Auth__SessionHours=10
# Höchstdauer ab der Anmeldung (Stunden), auch wenn der Tab ständig offen ist
Aufgaben__Auth__MaxSessionHours=24

# ---------------------------------------------------------------- Teams
# Die "id" aus teams/manifest (wird von teams/build-package.ps1 erzeugt)
Aufgaben__Teams__AppId=
Aufgaben__Teams__NotificationsEnabled=true
# Herausgeber im Teams-Paket (höchstens 32 Zeichen). Das Paket gibt es unter
# Verwaltung → System → „Teams-Paket herunterladen“ (braucht BaseUrl mit https, ClientId und AppId).
Aufgaben__Teams__Developer=

# ---------------------------------------------------------------- E-Mail (optional)
# Leer lassen = keine E-Mails (dann nur Teams-Benachrichtigungen)
Aufgaben__Mail__Host=
Aufgaben__Mail__Port=25
# None | StartTls | StartTlsWhenAvailable | SslOnConnect
Aufgaben__Mail__Security=StartTls
Aufgaben__Mail__Username=
Aufgaben__Mail__Password=
Aufgaben__Mail__From=aufgaben@example.de
Aufgaben__Mail__FromName=Aufgaben
# Optional: PEM der internen CA, falls der Mailserver ein internes Zertifikat hat
Aufgaben__Mail__CaCertificatePath=

# ---------------------------------------------------------------- Mail an Aufgabe (optional)
# Eigenes Postfach, das per IMAP abgerufen wird – Einrichtung: docs/mail-an-aufgabe.md
Aufgaben__MailInbox__Enabled=false
Aufgaben__MailInbox__Address=aufgaben@example.de
Aufgaben__MailInbox__Host=
Aufgaben__MailInbox__Port=993
Aufgaben__MailInbox__Security=SslOnConnect
Aufgaben__MailInbox__Username=
Aufgaben__MailInbox__Password=
Aufgaben__MailInbox__CaCertificatePath=
# exchange-intern (empfohlen bei Exchange) | bekannte-absender
Aufgaben__MailInbox__SenderCheck=exchange-intern
Aufgaben__MailInbox__SendConfirmation=true
Aufgaben__MailInbox__MaxAttachmentMb=15

# ---------------------------------------------------------------- Verzeichnis
Aufgaben__Directory__SyncEnabled=true
Aufgaben__Directory__SyncMinutes=360
# Optional: nur Mitglieder dieser Entra-Gruppe (Objekt-ID) übernehmen
Aufgaben__Directory__GroupId=

# ---------------------------------------------------------------- Hintergrunddienst
Aufgaben__Worker__DigestHour=7
Aufgaben__Worker__DigestOnWeekends=false

# ---------------------------------------------------------------- Datenbank
Aufgaben__Database__AutoMigrate=true
Aufgaben__Database__SeedExampleTemplates=true
